platform :ios, '17.0'
use_frameworks! :linkage => :static
project 'SpxChatIOS.xcodeproj'

target 'SpxChatIOS' do
  # Match Android's rtc_room_engine 3.6.4.104 and existing 1:1 signaling.
  pod 'RTCRoomEngine', '3.6.4'
  pod 'TXLiteAVSDK_TRTC', '12.8.19666'
  pod 'TXIMSDK_Plus_iOS_XCFramework', '8.8.7373'

  target 'SpxChatIOSTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end

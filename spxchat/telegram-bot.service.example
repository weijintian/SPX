[Unit]
Description=SPX Chat Telegram Notification Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/spxchat
ExecStart=/usr/bin/python3 /etc/spxchat/telegram-bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

# SPX Chat BSC 自动提现配置
# 使用方式：上传到 /etc/spxchat/withdrawal.env，再填写真实值。
# 不要把真实私钥提交到代码仓库，也不要通过网页提供下载。

# BSC 主网 RPC 地址
BSC_WITHDRAW_RPC_URL=https://bsc-dataseed1.binance.org

# 平台提现热钱包私钥，必须填写 0x 开头的 64 位私钥
BSC_WITHDRAW_PRIVATE_KEY=

# 平台提现热钱包地址。建议填写，并确保与私钥推导出的地址一致。
BSC_WITHDRAW_ADDRESS=

# BSC 链 ID
BSC_WITHDRAW_CHAIN_ID=56

# 每次发送 ERC-20 转账使用的 Gas 上限
BSC_WITHDRAW_GAS_LIMIT=100000

# 链上确认数达到该值后，后台提现才标记为已完成
BSC_WITHDRAW_CONFIRMATIONS=12

# 轮询间隔（秒）
BSC_WITHDRAW_POLL_SECONDS=30

# USDT 和 SPX001 都是 18 位精度
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955
BSC_SPX001_CONTRACT=0x0E920821464625cf661A4dceDEb6406E1B48FFFf
BSC_TOKEN_DECIMALS=18
